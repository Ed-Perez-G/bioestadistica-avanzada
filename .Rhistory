#| fig-height: 4.5
# Recta de mínimos cuadrados (azul) vs. otras rectas posibles (rojo)
p <- df |>
ggplot(aes(x = Consumo_Sal, y = Tension_Arterial)) +
geom_point(col = "#F0A05B", alpha = 0.8, size = 3) +
