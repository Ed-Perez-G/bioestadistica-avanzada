mutate(GrupoEdad =
case_when(Age < 18 ~ "Menor a 18",
Age < 65~ "Entre 18 y 64",
TRUE ~ "65 o mas"),
obesidad = if_else(BMI >30, "Obesidad", "No obesidad")) |>
group_by(Gender, GrupoEdad) |>
summarise(
