melanoma %>%
mutate(log_thickness = log(thickness)) %>%
pivot_longer(c(thickness, log_thickness),
names_to = "escala", values_to = "valor") %>%
mutate(escala = factor(escala,
levels = c("thickness", "log_thickness"),
labels = c("Original (mm)", "Log-transformada"))) %>%
ggplot(aes(x = valor)) +
geom_histogram(bins = 20, fill = "steelblue") +
facet_wrap(~ escala, ncol = 1, scales = "free") +
labs(title = "Grosor tumoral: original vs. log",
x = NULL, y = "Frecuencia") +
theme_minimal(base_size = 13)
