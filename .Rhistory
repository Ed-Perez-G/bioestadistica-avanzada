df |>
mutate(
GrupoEdad = case_when(
Age < 65 ~ "Menor de 65",
Age < 18 ~ "Menor de 18",
Age >= 65 ~ "65 o más"
)
)
df |>
mutate(
GrupoEdad = case_when(
Age < 65 ~ "Menor de 65",
Age < 18 ~ "Menor de 18",
Age >= 65 ~ "65 o más"
)
) |>
count(GrupoEdad)
