across(BMI, TotChol, BPSysAve, BPDiaAve)~
list(media = mean(.x, na.rm = T),
DE = sd(.x, na.rm = T)),
"Porcentaje obesidad" = sum(obesidad == "Obesidad")/
sum(!is.na(Obesidad)) * 100,
.groups = 'drop'
)
