Obesidad = BMI >= 30) |> # Variable 2
group_by(Gender, GrupoEdad) |>
summarise(
n = n(),
"Promedio BMI" = mean(BMI, na.rm= T),
"Mediana BMI" = median(BMI, na.rm = T),
"Promedio presion" = mean(BPSysAve, na.rm = T),
"Porcentaje obesidad" = Obesidad/n(Obesidad)*100,
.groups = "drop")
