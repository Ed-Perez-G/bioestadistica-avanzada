library(NHANES)
data("NHANES")
df <- NHANES
# df es un nombe común utilizado para las bases de datos es la abreviatura de df
df
df |>
mutate(NuevoGrupo =
ifelse(
Gender == "female" & Age >25,
"Grupo A",
"Grupo B"
))
