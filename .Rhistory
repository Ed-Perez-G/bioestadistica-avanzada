#| label: generar-datos
# Cargar paquetes:
# mice: imputación múltiple.
# tidyverse: creación, manipulación y visualización de datos.
library(mice)
library(tidyverse)
# Fijar la semilla para reproducir la simulación.
set.seed(9132026)
# Número de pacientes que vamos a simular.
n_practica <- 350
# Generar edades con una distribución uniforme entre 30 y 75 años.
# round() redondea las edades al entero más cercano.
edad_p <- round(runif(n_practica, 30, 75))
# Asignar una categoría de sexo a cada paciente.
# replace = TRUE permite seleccionar repetidamente la misma categoría.
# prob establece probabilidades de 55 % y 45 %.
# factor() convierte el resultado en una variable categórica.
# Las proporciones finales pueden variar por azar.
sexo_p <- factor(sample(
c("Mujer", "Hombre"),
n_practica,
replace = TRUE,
prob = c(0.55, 0.45)
))
# Asignar tabaquismo: 70 % de probabilidad de "No" y 30 % de "Sí".
tabaco_p <- factor(sample(
c("No", "Sí"),
n_practica,
replace = TRUE,
prob = c(0.70, 0.30)
))
# Simular IMC en kg/m²:
# - 27 es el valor base para una persona de 50 años.
# - 0.06 * (edad_p - 50) introduce una relación con la edad.
# - rnorm(n_practica, 0, 4) agrega variación normal con media 0 y DE 4.
# - pmax(..., 17) reemplaza los valores menores de 17 por 17.
# - pmin(..., 43) reemplaza los valores mayores de 43 por 43.
# - round(..., 1) conserva un decimal.
imc_p <- round(pmin(pmax(
27 + 0.06 * (edad_p - 50) +
rnorm(n_practica, 0, 4),
17
), 43), 1)
# Simular glucosa en ayuno en mg/dL:
# - Valor base de 100 para IMC de 27 y edad de 50 años.
# - Aumenta 1.8 unidades por cada unidad adicional de IMC.
# - Aumenta 0.35 unidades por cada año adicional de edad.
# - Se agrega variación normal con media 0 y DE 13.
# - Se establece un mínimo de 65 y se conserva un decimal.
glucosa_p <- round(pmax(
100 + 1.8 * (imc_p - 27) + 0.35 * (edad_p - 50) +
rnorm(n_practica, 0, 13),
65
), 1)
# Simular HbA1c expresada en porcentaje:
# - Valor base de 5.6 cuando la glucosa es 100 mg/dL.
# - Aumenta 0.035 puntos porcentuales por cada mg/dL adicional de glucosa.
# - Se agrega variación normal con media 0 y DE 0.45.
# - Se establece un mínimo de 4 y se conservan dos decimales.
hba1c_p <- round(pmax(
5.6 + 0.035 * (glucosa_p - 100) +
rnorm(n_practica, 0, 0.45),
4
), 2)
# Simular presión sistólica en mmHg:
# - Valor base de 120 para edad de 50 años e IMC de 27.
# - Aumenta con la edad y el IMC.
# - Se agrega variación normal con media 0 y DE 11.
# - Se redondea al entero más cercano.
presion_p <- round(
120 + 0.45 * (edad_p - 50) + 0.7 * (imc_p - 27) +
rnorm(n_practica, 0, 11)
)
# Reunir las variables en una tabla con una fila por paciente.
# seq_len(n_practica) genera identificadores del 1 al 350.
# Esta es la base completa que conservaremos como referencia.
practica_verdad <- tibble(
id = seq_len(n_practica),
edad = edad_p,
sexo = sexo_p,
tabaquismo = tabaco_p,
imc = imc_p,
glucosa_ayuno = glucosa_p,
hba1c = hba1c_p,
presion_sistolica = presion_p
)
# Crear indicadores de los valores que vamos a ocultar.
# TRUE: convertir ese valor en NA.
# FALSE: conservarlo observado.
#
# plogis() transforma un número en una probabilidad entre 0 y 1.
# rbinom(n, 1, probabilidad) genera un 0 o un 1 para cada paciente.
# == 1 convierte esos resultados en FALSE o TRUE.
#
# Edad, sexo y tabaquismo permanecerán completos.
practica_huecos <- tibble(
id = practica_verdad$id,
# MAR en IMC:
# La ausencia depende del tabaquismo y la edad, ambos observados.
# (tabaco_p == "Sí") aporta 1 para fumadores y 0 para no fumadores.
# Los coeficientes positivos aumentan la probabilidad de ausencia
# entre fumadores y pacientes de mayor edad.
imc = rbinom(n_practica, 1, plogis(
-1.5 + 0.9 * (tabaco_p == "Sí") +
0.025 * (edad_p - 50)
)) == 1,
# MAR en glucosa:
# La ausencia también depende de tabaquismo y edad.
# No depende directamente del valor de glucosa que se ocultará.
glucosa_ayuno = rbinom(n_practica, 1, plogis(
-1.5 + 0.8 * (tabaco_p == "Sí") +
0.03 * (edad_p - 50)
)) == 1,
# MNAR en HbA1c:
# La probabilidad de ausencia aumenta con la propia HbA1c.
# Los pacientes con valores altos tienen mayor probabilidad
# de perder esa medición.
hba1c = rbinom(n_practica, 1, plogis(
-1.3 + 1.8 * (hba1c_p - 5.6)
)) == 1,
# MCAR en presión sistólica:
# Todos tienen una probabilidad constante de ausencia del 20 %,
# independientemente de sus características y mediciones.
presion_sistolica = rbinom(n_practica, 1, 0.20) == 1
)
# Nombres de las columnas donde introduciremos los NA.
practica_variables <- c(
"imc", "glucosa_ayuno", "hba1c", "presion_sistolica"
)
# Crear una copia para introducir faltantes.
# practica_verdad conservará todos sus valores originales.
practica_incompletos <- practica_verdad
# Recorrer las cuatro variables, una por una.
# En cada vuelta, v contiene el nombre de una columna.
for (v in practica_variables) {
# [[v]] extrae la columna cuyo nombre está guardado en v.
# practica_huecos[[v]] identifica qué pacientes tienen TRUE.
# Solo esas posiciones se reemplazan por NA.
practica_incompletos[[v]][practica_huecos[[v]]] <- NA
}
# Verificar tres condiciones.
# stopifnot() detiene la ejecución con un error si alguna falla.
stopifnot(
# La base completa tiene 350 pacientes.
nrow(practica_verdad) == 350,
# La base verdadera no contiene ningún NA.
# anyNA() detecta faltantes y ! niega el resultado.
!anyNA(practica_verdad),
# Los identificadores y su orden coinciden en ambas bases.
identical(practica_verdad$id, practica_incompletos$id)
)
# Tabla de frecuencias absolutas
tabla_absoluta <- table(birthwt$low, birthwt$ht)
print("Frecuencias absolutas:")
print(tabla_absoluta)
# Tabla de frecuencias relativas (proporciones)
tabla_prop <- prop.table(tabla_absoluta, margin = 1)  # proporciones por fila
print("\nProporciones por categoría de bajo peso:")
print(round(tabla_prop, 3))
# Usando rstatix para descriptivos más elegantes
birthwt %>%
group_by(low, ht) %>%
summarise(n = n(), .groups = "drop") %>%
mutate(prop = n / sum(n))
#| message: false
library(MASS)
library(tidyverse)
library(rstatix)
library(ggstatsplot)
data("birthwt")
# Recodificar variables cualitativas con etiquetas descriptivas
birthwt <- birthwt %>%
mutate(
low = factor(low, labels = c("Peso Normal", "Bajo Peso")),
race = factor(race, labels = c("Blanca", "Negra", "Otra")),
smoke = factor(smoke, labels = c("No fumadora", "Fumadora")),
ht = factor(ht, labels = c("No hipertensión", "Hipertensión")),
ui = factor(ui, labels = c("No irritabilidad", "Irritabilidad"))
)
head(birthwt)
# Tabla de frecuencias absolutas
tabla_absoluta <- table(birthwt$low, birthwt$ht)
print("Frecuencias absolutas:")
print(tabla_absoluta)
# Tabla de frecuencias relativas (proporciones)
tabla_prop <- prop.table(tabla_absoluta, margin = 1)  # proporciones por fila
print("\nProporciones por categoría de bajo peso:")
print(round(tabla_prop, 3))
# Usando rstatix para descriptivos más elegantes
birthwt %>%
group_by(low, ht) %>%
summarise(n = n(), .groups = "drop") %>%
mutate(prop = n / sum(n))
# Tabla de frecuencias absolutas
birthwt |>
table(low, ht)
# Tabla de frecuencias absolutas
birthwt |>
coun(low, ht)
# Tabla de frecuencias absolutas
birthwt |>
count(low, ht)
# Tabla de frecuencias relativas (proporciones)
table(birthwt$low, birthwt$ht) |>
prop.table(margin = 2)
# Usando rstatix para descriptivos más elegantes
birthwt %>%
group_by(low, ht) %>%
summarise(n = n(), .groups = "drop") %>%
mutate(prop = n / sum(n))
# Gráfico de barras apiladas (proporciones)
p1 <- ggplot(birthwt, aes(x = low, fill = ht)) +
geom_bar(position = "fill", alpha = 0.8) +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Asociación entre Bajo Peso al Nacer e Hipertensión Materna",
x = "Peso al Nacer",
y = "Proporción",
fill = "Hipertensión"
) +
theme_minimal() +
theme(axis.text = element_text(size = 11))
print(p1)
# Gráfico de barras apiladas (proporciones)
p1 <- ggplot(birthwt, aes(x = low, fill = ht)) +
geom_bar(position = "fill", alpha = 0.8) +
scale_y_continuous(labels = scales::percent) + # cambia los eje a %
labs(
title = "Asociación entre Bajo Peso al Nacer e Hipertensión Materna",
x = "Peso al Nacer",
y = "Proporción",
fill = "Hipertensión"
) +
theme_minimal() +
theme(axis.text = element_text(size = 11))
print(p1)
# Gráfico de barras agrupadas (conteos)
p2 <- ggplot(birthwt, aes(x = low, fill = ht)) +
geom_bar(position = "dodge", alpha = 0.8) +
labs(
title = "Conteo de Casos",
x = "Peso al Nacer",
y = "Frecuencia",
fill = "Hipertensión"
) +
theme_minimal() +
geom_text(
stat = "count",
aes(label = after_stat(count)),
position = position_dodge(width = 0.9),
vjust = -0.5
)
print(p2)
