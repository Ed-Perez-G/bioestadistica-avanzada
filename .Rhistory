df |>
mutate(
GrupoEdad = case_when(
Age < 18 ~ "Menor de 18",
Age < 65 ~ "18 a 64",
TRUE ~ "65 o más"
),
Obesidad = BMI >= 30
) |>
group_by(Sex, GrupoEdad) |>
summarise(
n = n(),
BMI_promedio = mean(BMI, na.rm = TRUE),
BMI_mediana = median(BMI, na.rm = TRUE),
PAS_promedio = mean(BPSysAve, na.rm = TRUE),
Obesidad_pct = mean(Obesidad, na.rm = TRUE) * 100,
.groups = "drop"
)
